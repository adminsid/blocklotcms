{
  "name": "blocklotcms",
  "version": "1.0.0",
  "description": "Cloudflare Worker-based CMS for real estate websites — reusable blocks, RESO Web API integration, and a drag-and-drop builder",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply blocklotcms-db",
    "db:seed": "wrangler d1 execute blocklotcms-db --file=schema/seed.sql",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250430.0",
    "typescript": "^5.4.5",
    "wrangler": "^4.13.2",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "vitest": "^3.1.3"
  },
  "dependencies": {}
}
